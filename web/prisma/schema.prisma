// WebEaz CMS schema.
//
// Phase 1 introduced the Admin record used by the NextAuth credentials
// provider. This revision adds the content models that back the admin
// CMS modules. Every content model carries a ContentStatus so the
// public site can filter to PUBLISHED rows only, and every relation is
// owned server-side: the public pages read, only authenticated admins
// write.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Publishing workflow shared by every content module.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Blog submission workflow. `status` (ContentStatus) remains the
/// single public-visibility axis; `reviewStage` tracks the editorial
/// approval state and is never used directly for public filtering.
enum BlogReviewStage {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

model Admin {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("admin")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reviewedPosts     BlogPost[]         @relation("BlogReviewer")
  reviewedRevisions BlogPostRevision[] @relation("BlogRevisionReviewer")
  reviewedApplications ContributorApplication[] @relation("ApplicationReviewer")
  auditEvents       BlogPostAudit[]    @relation("BlogPostAudit")
}

// ---------------------------------------------------------------------------
// Homepage
// ---------------------------------------------------------------------------

/// Single-row record holding the hero and final-CTA copy.
model HomepageContent {
  id                 Int      @id @default(autoincrement())
  heroEyebrow        String   @default("Technology • Growth • Automation • AI")
  heroTitle          String   @default("Build. Transform. Automate. Grow.")
  heroDescription    String   @default("Technology and digital solutions that help businesses build, transform, automate and grow.")
  heroPrimaryLabel   String   @default("Let's Talk")
  heroPrimaryHref    String   @default("/contact")
  heroSecondaryLabel String   @default("Explore Our Services")
  heroSecondaryHref  String   @default("/services")
  heroImage          String?
  ctaEyebrow         String   @default("Let's talk")
  ctaTitle           String   @default("Let's Build What's Next.")
  ctaDescription     String   @default("Have a business challenge, digital idea or transformation goal? Let's create the right technology solution for your business.")
  ctaLabel           String   @default("Start a Conversation →")
  ctaHref            String   @default("/contact")
  updatedAt          DateTime @updatedAt
}

/// Eyebrow / title / description + visibility for each homepage section.
model HomepageSection {
  key         String   @id
  eyebrow     String   @default("")
  title       String
  description String   @default("")
  visible     Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// Homepage statistics. `group` separates the TrustStats strip
/// (value + unit + label) from the WhyWebEaz points (value + label).
model HomepageStat {
  id      Int      @id @default(autoincrement())
  group   String   @default("trust")
  value   String
  unit    String   @default("")
  label   String
  order   Int      @default(0)
  visible Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Industries
// ---------------------------------------------------------------------------

model Industry {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  order     Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Services (drives /services/[area] and /services/[area]/[service])
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  name        String
  num         String        @default("")
  tagline     String        @default("")
  description String        @default("")
  image       String?
  icon        String        @default("software")
  accent      String        @default("blue")
  order       Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  updatedAt   DateTime      @updatedAt
  services    Service[]
}

model Service {
  id           Int           @id @default(autoincrement())
  categoryId   Int
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  summary      String        @default("")
  icon         String        @default("software")
  /// Optional artwork shown on the service detail hero when set.
  image        String?
  seoTitle     String?
  seoDescription String?
  overview     String        @default("")
  provides     String[]      @default([])
  capabilities String[]      @default([])
  benefits     String[]      @default([])
  useCases     String[]      @default([])
  technologies String[]      @default([])
  order        Int           @default(0)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([categoryId, slug])
}

// ---------------------------------------------------------------------------
// Blog (drives /insights and /insights/[slug])
// ---------------------------------------------------------------------------

model BlogUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  posts        BlogPost[] @relation("BlogOwner")
  /// Approved contributor application this account was created from
  /// (null for admin-created accounts and legacy rows).
  applicationId Int?      @unique
  application   ContributorApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  invitations   ContributorInvitation[]
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  title           String
  excerpt         String        @default("")
  /// Article body. Rendered as plain paragraphs; blank lines split blocks.
  content         String        @default("")
  category        String        @default("Insights")
  coverImage      String?
  author          String        @default("WebEaz Technologies")
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  status          ContentStatus @default(DRAFT)
  ownerId         Int?
  owner           BlogUser?     @relation("BlogOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reviewStage     BlogReviewStage @default(DRAFT)
  rejectionReason String?
  reviewedBy      Int?
  reviewer        Admin?        @relation("BlogReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  revisions       BlogPostRevision[] @relation("BlogPostRevision")
  slugRedirects   BlogSlugRedirect[] @relation("BlogSlugRedirect")
  audits          BlogPostAudit[]    @relation("BlogPostAudit")

  @@index([ownerId, status])
  @@index([reviewStage, status])
}

/// Admin review audit actions (mirrors the review workflow so ownership
/// and review decisions stay auditable).
enum BlogAuditAction {
  ASSIGNED
  APPROVED
  RETURNED
  SLUG_CHANGED
}

model BlogPostRevision {
  id              Int             @id @default(autoincrement())
  blogPostId      Int
  blogPost        BlogPost        @relation("BlogPostRevision", fields: [blogPostId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  excerpt         String          @default("")
  content         String          @default("")
  category        String          @default("Insights")
  coverImage      String?
  author          String          @default("WebEaz Technologies")
  seoTitle        String?
  seoDescription  String?
  reviewStage     BlogReviewStage @default(DRAFT)
  rejectionReason String?
  reviewedBy      Int?
  reviewer        Admin?          @relation("BlogRevisionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([blogPostId, reviewStage])
  @@index([reviewStage, submittedAt])
}

model BlogSlugRedirect {
  oldSlug    String   @id
  blogPostId Int
  blogPost   BlogPost @relation("BlogSlugRedirect", fields: [blogPostId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model BlogPostAudit {
  id         Int            @id @default(autoincrement())
  blogPostId Int
  blogPost   BlogPost       @relation("BlogPostAudit", fields: [blogPostId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      Admin?         @relation("BlogPostAudit", fields: [adminId], references: [id], onDelete: SetNull)
  action     BlogAuditAction
  detail     String?
  createdAt  DateTime       @default(now())

  @@index([blogPostId, createdAt])
}

// ---------------------------------------------------------------------------
// Testimonials (drives the homepage "What Our Clients Say" grid)
// ---------------------------------------------------------------------------

enum ContributorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailDeliveryStatus {
  PENDING
  ACCEPTED
  FAILED
}

model ContributorApplication {
  id                  Int                         @id @default(autoincrement())
  fullName            String
  email               String
  professionalRole    String
  company             String?
  bio                 String
  linkedInUrl         String?
  portfolioUrl        String?
  contributionReason  String
  status              ContributorApplicationStatus @default(PENDING)
  reviewedBy          Int?
  reviewer            Admin?                      @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  rejectionReason     String?
  /// BlogUser created when this application was approved (once).
  approvedBlogUserId  Int?        @unique
  approvedBlogUser    BlogUser?
  invitation          ContributorInvitation?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([email, status])
}

model ContributorInvitation {
  id            Int                  @id @default(autoincrement())
  applicationId Int                  @unique
  application   ContributorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  blogUserId    Int                  @unique
  blogUser      BlogUser             @relation(fields: [blogUserId], references: [id], onDelete: Cascade)
  /// sha256 hex of the single-use token. The plaintext token only ever
  /// exists in the invitation email URL — never in the database.
  tokenHash     String               @unique
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  sentStatus    EmailDeliveryStatus  @default(PENDING)
  sentAt        DateTime?
  providerId    String?
  deliveryError String?
  createdAt     DateTime             @default(now())

  @@index([expiresAt])
}

model Testimonial {
  id        Int           @id @default(autoincrement())
  name      String
  role      String        @default("")
  company   String        @default("")
  companyLogo String?
  image     String        @default("")
  quote     String
  /// Only set when the rating was verified with the customer.
  rating    Int?
  order     Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Media library — metadata and object key only; file bytes live in object storage.
// ---------------------------------------------------------------------------

model MediaAsset {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  url          String
  storageKey   String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String   @default("")
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Site settings — key/value pairs rendered by the layout and footer.
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
